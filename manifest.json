{
  "manifest_version": 3,
  "name": "Ecolyze",
  "version": "0.1.0",
  "description": "Real-time sustainability insights for product pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/extractor.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://serpapi.com/*"
  ],
  "action": {
    "default_title": "Ecolyze – Sustainability Insights",
    "default_popup": "src/popup.html",
    "default_icon": "icons/ecolyzeLogo_16.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}