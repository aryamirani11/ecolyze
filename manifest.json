{
  "manifest_version": 3,
  "name": "Ecolyze",
  "version": "0.1.0",
  "description": "Real-time sustainability insights for eBay product pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.com.au/itm/*",
        "https://www.ebay.ca/itm/*",
        "https://www.ebay.fr/itm/*"
      ],
      "js": ["src/extractor.js", "src/overlay.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "action": {
    "default_title": "Ecolyze – Sustainability Insights"
  }
}
